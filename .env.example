# Copy to .env for the compose quickstart. Generate values with: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
BETTER_AUTH_SECRET=change-me-at-least-32-chars
BLAKTAIL_AUTH_HMAC_SECRET=change-me-at-least-32-chars
BLAKTAIL_RELAY_AUTH_SECRET=use-a-different-secret-at-least-32-chars
BLAKTAIL_DIAGNOSTICS_TOKEN=use-an-independent-diagnostics-token-at-least-32-chars
BLAKTAIL_RELAY_ENDPOINT=relay.example.org.au:3478
BETTER_AUTH_URL=https://console.example.org.au
BLAKTAIL_REGION=ap-southeast-2
