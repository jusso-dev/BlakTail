# Production must point to an onshore PostgreSQL service.
DATABASE_URL=postgres://blaktail:change-me@localhost:5432/blaktail
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-an-independent-random-value-at-least-32-bytes
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
COORD_BASE_URL=https://localhost:8443
# Must exactly match BLAKTAIL_AUTH_HMAC_SECRET on blaktail-coord.
BLAKTAIL_AUTH_HMAC_SECRET=replace-with-a-random-shared-value-at-least-32-bytes
