			<array>
				<string>blaktail</string>
			</array>
		</dict>
	</array>
	<key>NSVPNUsageDescription</key>
	<string>BlakTail creates an on-device encrypted path so this iPhone can join your organisation network.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
